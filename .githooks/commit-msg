#!/usr/bin/env bash
#
# ─────────────────────────────────────────────────────────────────────────────
#  LA BITÁCORA ES OBLIGATORIA EN CADA `fix:`
#
#  Un `fix:` es la confesión de que algo estuvo roto. Si el arreglo se commitea
#  sin dejar constancia de QUÉ pasó y —sobre todo— de QUÉ PRUEBA DIO VERDE
#  MIENTRAS EL FALLO ESTABA VIVO, ese dato se pierde para siempre: es
#  perecedero, y a los tres días ya nadie lo recuerda con precisión.
#
#  Este guardián NO bloquea a secas. Si falta la entrada, la AUTOGENERA con
#  todos los campos en NO CONSTA y la deja en el stage: cumplir tiene que ser
#  fácil, no solo incumplir difícil. `NO CONSTA` es un valor honesto y válido;
#  inventar, no.
#
#  La DECISIÓN viene de Turnia (002), que la tomó primero y la tiene en
#  producción. El código es propio: copiar el hook habría acoplado 004 a 002 y
#  heredado sus agujeros — y el suyo depende de `npm test`, que aquí no existe
#  porque el stack todavía no está decidido.
#
#  ⭐ DIFERENCIA CON EL DE TURNIA: aquel comprueba que docs/BITACORA.md esté EN
#     EL STAGE. Eso deja una puerta abierta: añadir el fichero con un cambio
#     trivial —una coma, un espacio— lo satisface sin escribir nada. Este
#     comprueba que el diff en stage AÑADA UNA CABECERA DE ENTRADA NUEVA
#     (`## [fecha] — título`). Se puede seguir engañando a propósito, claro,
#     pero ya no por accidente, que es de lo que protege un guardián.
#
#  INSTALACIÓN (los hooks NO viajan en git — un guardián que no existe en el
#  clon del que llega es un guardián que no existe):
#
#      git config core.hooksPath .githooks
#
#  Sin dependencias: solo git y utilidades POSIX. Nada de node ni npm.
# ─────────────────────────────────────────────────────────────────────────────

set -u

MSG_FILE="$1"
SUBJECT="$(head -n 1 "$MSG_FILE")"
BITACORA="docs/BITACORA.md"

# ¿El asunto es un fix?  Cubre: fix:  fix(ámbito):  fix!:  fix(ámbito)!:
es_fix() {
    printf '%s' "$SUBJECT" | grep -qE '^fix(\([^)]+\))?!?:'
}

# ¿El diff EN STAGE de la bitácora añade una cabecera de entrada nueva?
# Se mira el contenido añadido (líneas que empiezan por '+'), no la presencia
# del fichero. Una entrada es una línea '## [' — el formato de la bitácora.
anade_entrada() {
    git diff --cached -- "$BITACORA" \
        | grep -qE '^\+## \['
}

# ─────────────────────────────────────────────────────────────────────────────
# ⭐⭐ TANDA 31 · LA SEGUNDA PUERTA: ¿la entrada está en el commit ANTERIOR?
# ─────────────────────────────────────────────────────────────────────────────
#   La tanda 29 le encontró a este hook TRES falsos positivos, y los tres son el
#   mismo caso visto desde sitios distintos: **la entrada existe, pero no en el
#   diff en stage**.
#
#     1 · `git commit --amend`            la entrada está en el commit que se enmienda
#     2 · `git commit --amend --no-edit`  igual
#     3 · la bitácora en el commit ANTERIOR y el `fix:` en el siguiente
#
#   ⚠️⚠️ Y el tercero es el que manda, porque **el hook castigaba exactamente la
#     práctica que `CLAUDE.md` exige**: commits atómicos. Una entrada de bitácora
#     y un arreglo son dos cosas, y meterlas en el mismo commit para contentar al
#     guardián es dejar que el guardián escriba la historia.
#
#   ⇒ Se acepta también si la entrada entró en HEAD y **no** venía ya de HEAD~.
#     Los tres casos caen bajo esa única regla; no hace falta detectar `--amend`,
#     que desde `commit-msg` no se puede hacer limpiamente.
#
#   ⚠️⚠️ EFECTO LATERAL, DECLARADO: esto es MÁS LAXO. Con un commit que lleve la
#     entrada Y un `fix:` juntos, **el siguiente `fix:` también pasa** aunque no
#     traiga entrada propia — una entrada puede cubrir dos arreglos seguidos. Se
#     acepta a cambio de cero falsos positivos: un guardián que grita cuando no
#     debe se desactiva, y entonces no guarda nada.
#     ⛔ Lo que NO se ha aflojado: un `fix:` sin entrada en ningún sitio se sigue
#       rechazando, y eso se comprueba en `src/probar-hook.js`, no se promete.
entrada_en_head() {
    git rev-parse --verify -q HEAD >/dev/null 2>&1 || return 1
    if git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
        git diff HEAD~1 HEAD -- "$BITACORA" | grep -qE '^\+## \['
    else
        # primer commit del repositorio: no hay HEAD~1 con el que comparar
        git show --format= HEAD -- "$BITACORA" | grep -qE '^\+## \['
    fi
}

if es_fix && ! anade_entrada && ! entrada_en_head; then

    FECHA="$(date +%F)"
    TITULO="$(printf '%s' "$SUBJECT" | sed -E 's/^fix(\([^)]+\))?!?:[[:space:]]*//')"

    # ─────────────────────────────────────────────────────────────────────────
    # ⭐⭐ TANDA 31 · EL ESQUELETO **NO** SE ESCRIBE EN EL ÁRBOL — ley 39
    # ─────────────────────────────────────────────────────────────────────────
    #   Hasta hoy esto hacía `>> docs/BITACORA.md` y `git add`. O sea: **el
    #   guardián modificaba el estado que vigila**, y encima lo dejaba en el
    #   stage. En la tanda 26 eso coló una entrada de esqueleto entera —los nueve
    #   campos en NO CONSTA— dentro de un commit, y nadie la vio hasta contar las
    #   entradas dos días después (bitácora nº112).
    #   ⇒ El esqueleto va al directorio de git, que NO es el árbol de trabajo:
    #     nada que salga de aquí puede acabar en un commit por accidente.
    #   ⚠️ Y por eso el mensaje dice dónde está y qué hacer con él: cumplir tiene
    #     que seguir siendo fácil, que era el motivo de autogenerarlo.
    GIT_DIR_REAL="$(git rev-parse --git-dir)"
    ESQUELETO="$GIT_DIR_REAL/BITACORA-ESQUELETO.md"

    {
        printf '\n## [%s] — %s\n' "$FECHA" "$TITULO"
        printf '**Categoría:** NO CONSTA\n'
        printf '**Síntoma:** NO CONSTA\n'
        printf '**Qué se probó y DIO VERDE mientras el fallo estaba vivo:** ⭐ NO CONSTA\n'
        printf '**Causa raíz:** NO CONSTA\n'
        printf '**Cómo se cazó:** NO CONSTA\n'
        printf '**Arreglo aplicado:** NO CONSTA\n'
        printf '**Commit:** (este commit)\n'
        printf '**Ley que sale de aquí:** NO CONSTA\n'
        printf '**Traza:** NO CONSTA\n'
    } > "$ESQUELETO"

    {
        echo ''
        echo '──────────────────────────────────────────────────────────────────'
        echo '⚠️  COMMIT RECHAZADO: un `fix:` sin entrada en la bitácora.'
        echo ''
        echo '    Ni en este commit ni en el anterior.'
        echo ''
        echo "    He dejado un esqueleto con los nueve campos en NO CONSTA en:"
        echo "        $ESQUELETO"
        echo ''
        echo '    ⛔ NO lo he escrito en docs/BITACORA.md ni lo he puesto en el'
        echo '       stage: un guardián que modifica lo que vigila estropea la'
        echo '       operación siguiente aunque acierte en la suya, y ya coló'
        echo '       una entrada falsa en un commit (bitácora nº112).'
        echo ''
        echo '    Cópialo, rellena lo que sepas y vuelve a commitear. El campo ⭐'
        echo '    es el importante y el que se pierde: qué prueba estaba en VERDE'
        echo '    mientras el fallo ya existía. Si no hubo ninguna, déjalo en'
        echo '    NO CONSTA — es un valor honesto. Lo que no vale es inventarlo.'
        echo '──────────────────────────────────────────────────────────────────'
        echo ''
    } >&2

    exit 1
fi

exit 0
