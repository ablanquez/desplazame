{
  "name": "desplazame",
  "version": "1.0.0",
  "private": true,
  "description": "Raíz de workspaces. Aquí no vive código: solo el reparto en tipos, motor e interfaz.",
  "license": "Apache-2.0",
  "workspaces": [
    "tipos",
    "motor",
    "app"
  ],
  "scripts": {
    "comprobar-tipos": "npm run comprobar-tipos --workspace @desplazame/motor && npm run comprobar-tipos --workspace desplazame",
    "probar": "npm run probar --workspace @desplazame/motor && npm test --workspace desplazame",
    "build": "npm run build --workspace @desplazame/motor",
    "construir": "npm run construir --workspace desplazame",
    "comprobar-dist": "npm run comprobar-dist --workspace desplazame",
    "mantener-datos": "node scripts/mantener-datos.mjs",
    "local": "npm run local --workspace desplazame",
    "bateria": "node scripts/bateria.mjs",
    "bateria:esqueleto": "node scripts/bateria.mjs esqueleto",
    "bateria:dos-filas": "node scripts/bateria.mjs dos-filas",
    "bateria:identidad": "node scripts/bateria.mjs identidad",
    "bateria:creditos": "node scripts/bateria.mjs creditos",
    "bateria:pantalla": "node scripts/bateria.mjs pantalla",
    "bateria:pintura": "node scripts/bateria.mjs pintura",
    "bateria:bizi-y-resumen": "node scripts/bateria.mjs bizi-y-resumen",
    "bateria:proximo-bus": "node scripts/bateria.mjs proximo-bus",
    "bateria:moto": "node scripts/bateria.mjs moto",
    "bateria:yego": "node scripts/bateria.mjs yego"
  },
  "engines": {
    "node": ">=22"
  }
}
